# 复制为 .env 并填入真实 key；.env 已在 .gitignore，绝不提交
# 可选 qwen / gemini；没有可用模型配置时进入明确标识的 mock 演示模式
AI_PROVIDER=qwen

# 阿里云百炼：Key、地域与 Base URL 必须属于同一区域
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus

# 可选：使用 Google AI Studio 时改为 AI_PROVIDER=gemini 并填写
GEMINI_API_KEY=

# Google OAuth iOS Client ID，仅放本机 .env，不要提交真实配置
GOOGLE_CLIENT_ID=

# 推荐另建 Web application Client ID，供后端验证 ID Token；与 iOS Client ID 分开
# 后端优先使用此项；留空时兼容仅配置 iOS Client ID 的开发环境
GOOGLE_SERVER_CLIENT_ID=
